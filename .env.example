# Local Docker example. Spring Boot does not automatically read this file.
# Copy to .env, then: docker run --env-file .env -p 8080:8080 inventory:local
SERVER_PORT=8080
# Empty starts with an empty inventory; use demo only for controlled demonstrations.
SPRING_PROFILES_ACTIVE=
DB_URL=jdbc:h2:mem:inventory;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_USERNAME=sa
# Local H2 example only. Kubernetes obtains credentials from a Secret.
DB_PASSWORD=
LOGGING_LEVEL_ROOT=INFO
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=65.0 -XX:+ExitOnOutOfMemoryError
