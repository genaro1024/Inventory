{
  "openapi": "3.0.1",
  "info": {
    "title": "API de reservas de inventario",
    "description": "Reservas temporales, confirmaciones idempotentes y disponibilidad. Todas las respuestas de negocio tienen success, message, data y traceId.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Servidor actual"
    }
  ],
  "paths": {
    "/reservations": {
      "post": {
        "tags": [
          "Reservas"
        ],
        "summary": "Reservar unidades",
        "description": "Los reintentos conservan la reserva original. No reactiva pedidos vencidos.",
        "operationId": "reserve",
        "parameters": [
          {
            "name": "X-Trace-Id",
            "in": "header",
            "description": "Correlación opcional; si falta o es inválida, el servidor genera un UUID.",
            "required": false,
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]{1,64}$",
              "type": "string",
              "example": "frontend-trace-123"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReserveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-Trace-Id": {
                "description": "Mismo identificador que el traceId del cuerpo.",
                "schema": {
                  "maxLength": 64,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._-]{1,64}$",
                  "type": "string",
                  "example": "frontend-trace-123"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseReservation"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida.",
            "headers": {
              "X-Trace-Id": {
                "description": "Mismo identificador que el traceId del cuerpo.",
                "schema": {
                  "maxLength": 64,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._-]{1,64}$",
                  "type": "string",
                  "example": "frontend-trace-123"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "Revisa los datos de tu solicitud e inténtalo nuevamente.",
                  "data": null,
                  "traceId": "frontend-trace-123"
                }
              }
            }
          },
          "406": {
            "description": "La API responde en JSON.",
            "headers": {
              "X-Trace-Id": {
                "description": "Mismo identificador que el traceId del cuerpo.",
                "schema": {
                  "maxLength": 64,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._-]{1,64}$",
                  "type": "string",
                  "example": "frontend-trace-123"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "Revisa los datos de tu solicitud e inténtalo nuevamente.",
                  "data": null,
                  "traceId": "frontend-trace-123"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto con las reglas o el estado del inventario o pedido.",
            "headers": {
              "X-Trace-Id": {
                "description": "Mismo identificador que el traceId del cuerpo.",
                "schema": {
                  "maxLength": 64,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._-]{1,64}$",
                  "type": "string",
                  "example": "frontend-trace-123"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "No hay suficientes unidades disponibles para tu pedido.",
                  "data": null,
                  "traceId": "frontend-trace-123"
                }
              }
            }
          },
          "415": {
            "description": "El cuerpo debe usar application/json.",
